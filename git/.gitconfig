[user]
	name = bkegley
	email = hi@bryankegley.me

[credential]
	helper = cache

[core]
    pager = delta
	excludesFile = /Users/bkegley/.gitignore_global

[delta]
    features = side-by-side line-numbers decorations
    # Skip the OSC 10/11 terminal background probe. Without this delta races
    # with less for the terminal and leaks its query reply (/0000/0000ESC\)
    # onto less's status line, eating the first keypress. Setting dark
    # explicitly disables the probe.
    dark = true
    detect-dark-light = never
    plus-style = syntax "#003800"
    minus-style = syntax "#3f0001"
    plus-color = "#012800"
    minus-color = "#340001"
    syntax-theme = Nord
    line-numbers = true

[delta "decorations"]
    commit-decoration-style = bold cyan box ul
    file-decoration-style = none
    hunk-header-decoration-style = cyan box ul

[delta "line-numbers"]
    line-numbers-left-style = cyan
    line-numbers-right-style = cyan
    line-numbers-minus-style = 124
    line-numbers-plus-style = 28

[init]
	defaultBranch = main

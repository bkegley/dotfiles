layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="compact-bar"
        }
    }

    cwd "/Users/bkegley/repos/assistant"

    tab name="assistant" focus=true {
        pane split_direction="vertical" {
            pane command="nvim" {
                args "."
            }
            pane command="claude"
        }
    }
}

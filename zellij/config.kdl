// Zellij config — Alt-based keybinds to avoid Ctrl conflicts with nvim/terminal apps.

keybinds clear-defaults=true {
    // Global: always available, even in Locked mode
    shared {
        bind "Ctrl q" { Quit; }
        bind "Ctrl g" { SwitchToMode "Locked"; }
    }

    // Everywhere except Locked
    shared_except "locked" {
        // Pane focus (no mode switch). Falls through to next tab at edges.
        bind "Alt h" { MoveFocusOrTab "left"; }
        bind "Alt j" { MoveFocus "down"; }
        bind "Alt k" { MoveFocus "up"; }
        bind "Alt l" { MoveFocusOrTab "right"; }

        // Pane create / split
        bind "Alt n" { NewPane; }
        bind "Alt s" { NewPane "down"; }
        bind "Alt v" { NewPane "right"; }
        bind "Alt x" { CloseFocus; }

        // Pane fullscreen / floating
        bind "Alt f" { ToggleFocusFullscreen; }
        bind "Alt w" { ToggleFloatingPanes; }

        // Tab navigation
        bind "Alt 1" { GoToTab 1; }
        bind "Alt 2" { GoToTab 2; }
        bind "Alt 3" { GoToTab 3; }
        bind "Alt 4" { GoToTab 4; }
        bind "Alt 5" { GoToTab 5; }
        bind "Alt 6" { GoToTab 6; }
        bind "Alt 7" { GoToTab 7; }
        bind "Alt 8" { GoToTab 8; }
        bind "Alt 9" { GoToTab 9; }
        bind "Alt [" { GoToPreviousTab; }
        bind "Alt ]" { GoToNextTab; }
        bind "Alt t" { NewTab; }

        // Resize (Alt + Shift + direction)
        bind "Alt H" { Resize "Increase left"; }
        bind "Alt J" { Resize "Increase down"; }
        bind "Alt K" { Resize "Increase up"; }
        bind "Alt L" { Resize "Increase right"; }

        // Scroll
        bind "Alt u" { HalfPageScrollUp; }
        bind "Alt d" { HalfPageScrollDown; }

        // Session
        bind "Alt o" { Detach; }
    }

    // Locked mode: only Ctrl+g exits. nvim/Claude get all other keys.
    locked {
        bind "Ctrl g" { SwitchToMode "Normal"; }
    }
}

// Plugin aliases - can be used to change the implementation of Zellij
// changing these requires a restart to take effect
plugins {
    about location="zellij:about"
    compact-bar location="zellij:compact-bar"
    configuration location="zellij:configuration"
    filepicker location="zellij:strider" {
        cwd "/"
    }
    plugin-manager location="zellij:plugin-manager"
    session-manager location="zellij:session-manager"
    status-bar location="zellij:status-bar"
    strider location="zellij:strider"
    tab-bar location="zellij:tab-bar"
    welcome-screen location="zellij:session-manager" {
        welcome_screen true
    }
}

// Plugins to load in the background when a new session starts
load_plugins {
}
web_client {
    font "monospace"
}

simplified_ui false
default_mode "normal"
default_layout "blank"
layout_dir "/Users/bkegley/.config/zellij/layouts"
mouse_mode true
pane_frames true
on_force_close "detach"
scroll_buffer_size 100000
copy_command "pbcopy"
copy_clipboard "system"
copy_on_select true
session_serialization false
disable_session_metadata true
show_startup_tips false
web_server_cert "/Users/bkegley/.config/zellij/certs/cert.pem"
web_server_key "/Users/bkegley/.config/zellij/certs/key.pem"
